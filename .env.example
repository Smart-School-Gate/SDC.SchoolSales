# PostgreSQL Connection String (Neon)
ConnectionStrings__DefaultConnection=Host=your-neon-host.aws.neon.tech;Database=school_sales;Username=your_user;Password=your_password;SSL Mode=Require;Trust Server Certificate=true;

# JWT Configuration
Jwt__SecretKey=Your_Very_Long_And_Super_Secure_JWT_Key_2026_At_Least_32_Chars!
Jwt__Issuer=SmartDevCo.SchoolSales
Jwt__Audience=SmartDevCo.SchoolSales.Client
Jwt__AccessTokenExpirationMinutes=120
Jwt__RefreshTokenExpirationDays=7

# Initial SuperAdmin Bootstrap
Bootstrap__SuperAdminEmail=admin@smartdevco.com
Bootstrap__SuperAdminPassword=ChangeThisSecurePassword!
Bootstrap__SuperAdminFullName=SmartDevCo SuperAdmin
